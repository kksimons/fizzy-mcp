{
  "name": "fizzy-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Model Context Protocol server for Fizzy (37signals) — agent/voice control of boards, cards, columns, comments and tags. Built with Effect + @effect/ai.",
  "author": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/kksimons/fizzy-mcp.git"
  },
  "homepage": "https://github.com/kksimons/fizzy-mcp#readme",
  "bugs": {
    "url": "https://github.com/kksimons/fizzy-mcp/issues"
  },
  "bin": {
    "fizzy-mcp": "bin/fizzy-mcp"
  },
  "scripts": {
    "build": "rm -rf dist && tsgo -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "check": "bun run typecheck && bun run lint && bun run test && bun run build"
  },
  "dependencies": {
    "@effect/ai": "^0.36.0",
    "@effect/experimental": "^0.60.0",
    "@effect/platform": "^0.96.2",
    "@effect/platform-node": "^0.107.0",
    "@effect/rpc": "^0.75.1",
    "effect": "^3.21.4"
  },
  "devDependencies": {
    "@effect/eslint-plugin": "^0.3.2",
    "@effect/vitest": "^0.29.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.0",
    "@typescript/native-preview": "^7.0.0-dev.0",
    "eslint": "^10.6.0",
    "tsx": "^4.22.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=20"
  }
}
